{
  "name": "react-inputx",
  "version": "1.0.1",
  "description": "Reusable React input with controlled/uncontrolled modes, clear actions, adornments, and debounced callbacks",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wilsocr88/react-inputx.git"
  },
  "bugs": {
    "url": "https://github.com/wilsocr88/react-inputx/issues"
  },
  "homepage": "https://github.com/wilsocr88/react-inputx#readme",
  "main": "lib/index.cjs",
  "module": "lib/index.js",
  "exports": {
    ".": {
      "import": "./lib/index.js",
      "require": "./lib/index.cjs",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "README.md"
  ],
  "sideEffects": false,
  "keywords": [
    "react",
    "input",
    "component",
    "debounce",
    "search",
    "clearable"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:demo && npm run build:lib",
    "build:demo": "vite build",
    "clean:lib": "node -e \"require('fs').rmSync('lib', { recursive: true, force: true })\"",
    "build:lib": "npm run clean:lib && vite build --mode lib",
    "preview": "vite preview",
    "check:package": "npm pack --dry-run",
    "prepublishOnly": "npm run build:lib && npm run check:package"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "react": ">=17",
    "react-dom": ">=17"
  },
  "dependencies": {
    "react-icons": "^5.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^7.0.4"
  }
}
